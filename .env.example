# Dev-only Zotero instance. Keep it pointed at a throwaway profile and data dir
# so `npm start` never touches your real library.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_PROFILE_PATH=/path/to/ZoteroChatDev/profile
ZOTERO_PLUGIN_DATA_DIR=/path/to/ZoteroChatDev/data
