{
  "name": "zoterochat",
  "version": "0.1.0",
  "description": "Zotero 侧栏论文阅读助手：以打开的 PDF 为会话边界，前缀冻结换取高缓存命中率",
  "author": "bowentian",
  "homepage": "https://github.com/bowentian/ZoteroChat",
  "repository": {
    "type": "git",
    "url": "https://github.com/bowentian/ZoteroChat.git"
  },
  "config": {
    "addonName": "ZoteroChat",
    "addonID": "zoterochat@bowentian",
    "addonRef": "zoterochat",
    "addonInstance": "ZoteroChat",
    "prefsPrefix": "extensions.zotero.zoterochat"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i src/ui/styles/tailwind.css -o .build/panel.css",
    "css:watch": "tailwindcss -i src/ui/styles/tailwind.css -o .build/panel.css --watch",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.475.0",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  }
}
