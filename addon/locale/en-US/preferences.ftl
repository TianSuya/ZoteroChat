prefs-lead = OpenAI-compatible endpoint. The current paper is sent as context with every question.
prefs-connection = Connection
prefs-base-url = Base URL
prefs-base-url-hint = Example: https://api.deepseek.com — /chat/completions is appended.
prefs-api-key = API key
prefs-api-key-hint = Stored in this Zotero profile. Sent only to the endpoint above.
prefs-model = Model
prefs-model-hint = Example: deepseek-flash
prefs-language = Preferred language
prefs-language-hint = Shortcut prompts and answers use this language. Auto follows the question. The frozen paper prefix does not change.
prefs-font-size = Font size
prefs-font-size-hint = Chat panel text size. Default is 14. Click Save and refresh afterward.
prefs-apply = Save and refresh
prefs-test = Test connection
prefs-status-idle = Not tested yet
prefs-status-applied = Saved and chat refreshed
prefs-status-checking = Checking…
prefs-status-ok = Connected · { $model }
prefs-status-fail = Couldn’t connect · { $detail }
prefs-translate = Translation
prefs-translate-lead = Shown in the PDF selection popup. Target language follows Preferred language above.
prefs-translate-engine = Engine
prefs-translate-engine-hint = Google needs no key. Chat model uses the connection settings above. If Google is blocked, switch engine.
prefs-translate-deepl-key = DeepL API key
prefs-translate-google-cloud-key = Google Cloud API key
prefs-translate-azure-key = Azure Translator key
prefs-translate-azure-region = Azure region
prefs-translate-azure-region-hint = Default global. Only used by Azure Translator.
prefs-translate-font-size = Translation font size
prefs-translate-font-size-hint = Size of translated text in the PDF selection popup. A− / A+ on the popup also change it.
prefs-tools = Search and tools
prefs-tools-lead = DeepSeek Search and Fetch let the assistant look beyond the paper. Search is billed per successful request, not per token.
prefs-search-enabled = Web search
prefs-search-enabled-hint = Let the assistant search the web and read pages when the paper alone is not enough.
prefs-search-api-key = Search API key
prefs-search-api-key-hint = Optional. Leave empty to reuse the API key above. Search and Fetch use the same DeepSeek account.
prefs-search-base-url = Search Base URL
prefs-search-base-url-hint = Default: https://api.deepseek.com. /v1/tools/search and /v1/tools/fetch are appended.
prefs-allow-paper-downloads = Add papers to Zotero
prefs-allow-paper-downloads-hint = Let the assistant download a paper after you confirm it. Every write asks first.
prefs-test-search = Test search
prefs-status-checking-search = Checking search…
prefs-status-search-ok = Search ready · { $detail }
