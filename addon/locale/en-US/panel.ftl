# `collapsible-section` reads the `label` attribute; a bare value would be
# written into its textContent and wipe out the header's icon and twisty.
panel-header =
    .label = Chat
panel-sidenav-tooltip =
    .tooltiptext = Chat about this paper
panel-empty-title = Ask about this paper
panel-empty-hint = The full text is already in context. Select text in the PDF to ask about a specific passage.
panel-composer-placeholder = Ask anything… (press / for commands)
panel-not-a-pdf = Open a PDF attachment to start chatting.
